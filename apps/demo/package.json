{
  "name": "@agentronics/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "clean": "rm -rf dist .turbo test-results"
  },
  "dependencies": {
    "@agentronics/protocol": "workspace:*",
    "@agentronics/react": "workspace:*",
    "@agentronics/sdk": "workspace:*",
    "@agentronics/theme": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@agentronics/eslint-config": "workspace:*",
    "@agentronics/tsconfig": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}

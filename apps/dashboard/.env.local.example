# Browser-visible URL of the gateway. Defaults to localhost in dev.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787

# --- Clerk (real auth) -------------------------------------------------------
# Both must be set together. If either is missing the dashboard runs in
# "demo mode" (every visitor maps to the stub demo org). See `lib/auth.ts`.
# Get these from https://dashboard.clerk.com → "API keys" for the Agentronics
# Dashboard application. Org-mode must be enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Org defaults shown on /settings ----------------------------------------
# Surfaced as read-only context on the Settings page. Does not affect routing.
# Override per environment (e.g. `eu-west-1` for the EU dashboard deploy).
AGENTRONICS_REGION=us-east-1
# Default siteId shown when the operator hasn't picked one yet. Match this to
# whatever site the demo / first-touch flow uses (the in-memory fixture seeds
# `demo-site`).
AGENTRONICS_SITE_ID=default

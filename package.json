{
  "name": "agentronics-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Agentronics SDK monorepo \u2014 universal governance layer for agent-surfable websites.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "size": "turbo run size",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "sync-readme": "tsx scripts/sync-readme.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "brace-expansion@<1.1.17": "^1.1.17",
      "brace-expansion@>=5 <5.0.9": "^5.0.9",
      "js-cookie@<3.0.7": "^3.0.7",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "protobufjs@<7.6.5": "^7.6.5",
      "postcss-selector-parser@>=7 <7.1.3": "^7.1.3",
      "sharp@<0.35.4": "^0.35.5"

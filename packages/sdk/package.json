{
  "name": "@agentronics/sdk",
  "version": "0.6.0",
  "description": "Authentication for AI agents — verify every agent on your site (WebMCP, browser agents, crawlers, API agents) with any method: Web Bot Auth, API keys, OAuth2, SSO, SPIFFE, mTLS.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentronics-t/sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://sdk.agentronics.dev",
  "bugs": "https://github.com/agentronics-t/sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js",
      "require": "./dist/lite.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@agentronics/protocol": "workspace:*",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@agentronics/eslint-config": "workspace:*",
    "@agentronics/tsconfig": "workspace:*",
    "@agentronics/tsup-config": "workspace:*",
    "@size-limit/preset-small-lib": "^11.1.6",
    "happy-dom": "^15.11.7",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "next": "^15.5.27"
  },
  "size-limit": [
    {
      "name": "Agentronics.init reachable graph (esm, brotli)",
      "path": "dist/init-only.js",
      "limit": "25 KB"
    },
    {
      "name": "lite (esm, gzipped)",
      "path": "dist/lite.js",
      "limit": "8 KB"
    },
    {
      "name": "full (esm, gzipped)",
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "keywords": [
    "ai-agents",
    "agent-authentication",
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "webmcp",
    "bot-verification",
    "oauth2",
    "mtls",
    "spiffe"
  ]
}

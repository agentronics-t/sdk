    "@agentronics/tsup-config": "workspace:*",
    "@types/node": "^22.10.1",
    "drizzle-kit": "^0.28.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"

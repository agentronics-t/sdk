NODE_ENV=development
PORT=8787
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Shared secret for cron-only routes (Vercel Cron, /v1/admin/keys/invalidate).
# Required for /v1/cron/* and /v1/admin/* — when unset those endpoints
# refuse every request. Generate with: openssl rand -hex 32
CRON_SECRET=

# Comma-separated list of proxy IPs/CIDRs that the gateway sits behind.
# When non-empty, x-forwarded-for / x-real-ip are trusted for rate-limit
# keying; otherwise those headers are ignored to defeat spoofing.
TRUSTED_PROXY_IPS=

# Optional fixture seeding for local development. Never set in prod.
SEED_FIXTURE=false

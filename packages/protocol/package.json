{
  "name": "@agentronics/protocol",
  "version": "0.2.0",
  "description": "Shared zero-dependency DTOs and schemas for the Agentronics SDK and gateway.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentronics-t/sdk.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://sdk.agentronics.dev",
  "bugs": "https://github.com/agentronics-t/sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agentronics/eslint-config": "workspace:*",
    "@agentronics/tsconfig": "workspace:*",
    "@agentronics/tsup-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

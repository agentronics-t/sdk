{
  "name": "@agentronics/theme",
  "version": "0.1.0",
  "description": "Shared design tokens (CSS variables) and Space Mono font helpers for every Agentronics surface.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
  },
  "files": ["dist", "src/tokens.css", "src/fonts.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@agentronics/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
